APP_NAME=Echowa
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://127.0.0.1:3000
APP_HOST=127.0.0.1
APP_PORT=3000

# SQLite file for Echowa's own data. Relative paths resolve from the working
# directory; use an absolute path in production (/var/lib/echowa/echowa.sqlite).
DB_DATABASE=database/echowa.sqlite
