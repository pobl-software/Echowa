# /etc/echowa/env: Echowa's configuration on a server (docs/mvp.md,
# "Configuration"). `echowa setup` creates it once, with a fresh APP_KEY, and
# never overwrites it. Owned by root, readable by the echowa group (0640).
# Keep values free of spaces and quotes: systemd and echowa-artisan both
# read this file.
#
# BACK UP APP_KEY. Registry tokens, env values and webhook secrets are
# encrypted with it. A database backup without the key can't be decrypted,
# and a lost key can't be recovered. Keep it apart from database backups.

APP_ENV=production
APP_DEBUG=false
APP_KEY=
# The URL you open the UI on. With https://, cookies are Secure and responses
# carry HSTS (also right behind Cloudflare Tunnel or Tailscale Serve, which
# terminate TLS for Echowa).
APP_URL=https://echowa.example.com

# Where Echowa listens, set by echowa setup from how you chose to reach the
# UI (ADR 0022): 0.0.0.0:8192 for HTTP, the Docker bridge gateway behind
# Traefik for HTTPS (which serves it on 8192), loopback for a Cloudflare
# Tunnel. Whoever signs in
# controls docker.sock, which is root.
APP_HOST=127.0.0.1
APP_PORT=3000

DB_DATABASE=/var/lib/echowa/echowa.sqlite

# Header that names the real client when a request arrives from loopback
# (cloudflared sets CF-Connecting-IP) or from ECHOWA_TRUSTED_PROXIES
# (Traefik sets X-Real-IP). Empty trusts none.
#ECHOWA_CLIENT_IP_HEADER=CF-Connecting-IP
#ECHOWA_TRUSTED_PROXIES=

#ECHOWA_DOCKER_HOST=unix:///var/run/docker.sock
#ECHOWA_NETWORK=echowa-public
#ECHOWA_CERT_RESOLVER=le
# Where the Domains tab reads Traefik's certificates (ADR 0029).
#ECHOWA_TRAEFIK_HTTPS=127.0.0.1:443
#ECHOWA_UPDATE_MONITOR=30s
#ECHOWA_DEPLOY_TIMEOUT=10m
#ECHOWA_PRUNE_KEEP=5
#ECHOWA_PRUNE_MIN_AGE=72h
